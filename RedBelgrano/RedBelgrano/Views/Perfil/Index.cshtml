<!-- TÍTULO EXTERNO -->
<h1 class="perfil-page-title">Perfil</h1>

<div class="perfil-wrapper">

    <!-- TARJETA PRINCIPAL -->
    <div class="perfil-main-card">

        <!-- NOMBRE DESTACADO -->
        
        <div class="perfil-name-block">
            <h2>@Model.Nombre</h2>

            <span class="perfil-user-type
                @(Model.TipoUsuario == "Administrador" ? "tipo-admin" : "tipo-normal")">
                @Model.TipoUsuario
            </span>
            </div>

        <!-- INFORMACIÓN GENERAL -->
        <div class="perfil-info-grid">

            <div class="perfil-info-item">
                <label class="label"> Email </label>
                <span>@Model.Email</span>
            </div>

            <div class="perfil-info-item">
                <label> DNI </label>
                <span>@Model.Dni</span>
            </div>

        </div>

        <!-- SECCIÓN RESIDENTE -->
        @if (Model.Residente != null)
        {
            @*<hr class="perfil-divider" />

            <h3 class="perfil-section-title">Datos de Residente</h3>
            *@
            <div class="perfil-info-grid">

                <div class="perfil-info-item">
                    <label>Nombre</label>
                    <span>@Model.Residente.Nombre</span>
                </div>

                <div class="perfil-info-item">
                    <label>Apellido</label>
                    <span>@Model.Residente.Apellido</span>
                </div>

                <div class="perfil-info-item">
                    <label>Email</label>
                    <span>@Model.Residente.Email</span>
                </div>

                <div class="perfil-info-item">
                    <label>Teléfono</label>
                    <span>@Model.Residente.Telefono</span>
                </div>

                <div class="perfil-info-item">
                    <label>Ubicación</label>
                    <span>Piso @Model.Residente.Piso - Depto @Model.Residente.Departamento</span>
                </div>

                <div class="perfil-info-item">
                    <label>Tipo</label>
                    <span>@Model.Residente.TipoResidente</span>
                </div>

                <div class="perfil-info-item">
                    <label>Estado</label>
                    @if (Model.Residente.Estado != null && Model.Residente.Estado == "activo")
                    {
                        <p class="perfil-estado estado-activo">
                            @Model.Residente.Estado
                        </p>
                    }
                    else
                    {
                        <p class="perfil-estado estado-inactivo">
                            @Model.Residente.Estado
                        </p>
                    }
                </div>

            </div>
        }

        <!-- ACCIONES -->
        <div class="perfil-actions">
            <a asp-action="CambiarClave" class="perfil-btn">Cambiar contraseña</a>
        </div>

    </div>
</div>