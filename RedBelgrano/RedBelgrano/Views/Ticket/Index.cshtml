@model RedBelgrano.DataViewModel.FiltroTicketViewModel
<link rel="stylesheet" href="~/css/Ticket.css" />

<div class="tickets-container">

    <h1 class="tickets-title">Gestión de Tickets</h1>

    <!-- FILTROS -->
    <!-- FILTROS -->
    <div class="filtros-block">

        <div class="filtros-header">
        </div>

        <form method="get" class="filtros-inline">
            <div class="filtro-item">
                <label>Estado</label>
                <select asp-for="EstadoTicketId"
                        asp-items="Model.Estados"
                        class="form-control filtro-control">
                    <option value="">Todos</option>
                </select>
            </div>

            <div class="filtro-item">
                <label>Categoría</label>
                <select asp-for="CategoriaTicketId"
                        asp-items="Model.Categorias"
                        class="form-control filtro-control">
                    <option value="">Todas</option>
                </select>
            </div>

            <div class="filtro-actions">
                <button type="submit" class="btn-filtrar">
                    Filtrar
                </button>
            </div>
        </form>
    </div>


    <!-- LISTADO -->
    @if (Model.Tickets != null && Model.Tickets.Any())
    {
        @foreach (var ticket in Model.Tickets)
        {
            <div class="ticket-item">

                <div class="ticket-header">
                    <div>
                        <div class="ticket-title">
                            @ticket.Titulo
                        </div>
                        <div class="ticket-meta">
                            @ticket.Categoria · @ticket.Estado <br />
                            @ticket.Emisor · @ticket.FechaCreacion.ToString("dd/MM/yyyy HH:mm")
                        </div>
                    </div>
                </div>

                <div class="ticket-content">
                    @ticket.Contenido
                </div>

                <div class="ticket-actions">
                    <form asp-action="CambiarEstado" method="post">
                        @Html.AntiForgeryToken()

                        <input type="hidden" name="ticketId" value="@ticket.Id" />

                        <select name="nuevoEstadoId" class="estado-select">
                            @foreach (var estado in Model.Estados)
                            {
                                <option value="@estado.Value"
                                        selected="@(estado.Text == ticket.Estado)">
                                    @estado.Text
                                </option>
                            }
                        </select>

                        <button type="submit" class="btn-primary btn-small">
                            Cambiar
                        </button>
                    </form>
                </div>

            </div>
        }
    }
    else
    {
        <p>No hay tickets para mostrar.</p>
    }

    @if (Model.TotalPaginas > 1)
    {
        <div class="paginacion-container">

            @if (Model.PaginaActual > 1)
            {
                <a class="btn-paginacion"
                   asp-action="Index"
                   asp-route-pagina="@(Model.PaginaActual - 1)"
                   asp-route-EstadoTicketId="@Model.EstadoTicketId"
                   asp-route-CategoriaTicketId="@Model.CategoriaTicketId">
                    ← Anterior
                </a>
            }

            @for (int i = 1; i <= Model.TotalPaginas; i++)
            {
                <a class="btn-paginacion @(i == Model.PaginaActual ? "activo" : "")"
                   asp-action="Index"
                   asp-route-pagina="@i"
                   asp-route-EstadoTicketId="@Model.EstadoTicketId"
                   asp-route-CategoriaTicketId="@Model.CategoriaTicketId">
                    @i
                </a>
            }

            @if (Model.PaginaActual < Model.TotalPaginas)
            {
                <a class="btn-paginacion"
                   asp-action="Index"
                   asp-route-pagina="@(Model.PaginaActual + 1)"
                   asp-route-EstadoTicketId="@Model.EstadoTicketId"
                   asp-route-CategoriaTicketId="@Model.CategoriaTicketId">
                    Siguiente →
                </a>
            }

        </div>
    }

</div>
