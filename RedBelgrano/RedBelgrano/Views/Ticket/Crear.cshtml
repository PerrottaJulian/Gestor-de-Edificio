@model RedBelgrano.DataViewModel.CrearTicketViewModel
<link rel="stylesheet" href="~/css/Ticket.css" />

<div class="tickets-container">

    <div class="residente-layout">

        <!-- FORMULARIO -->
        <div class="form-block">

            <div class="form-header">
                <h2 class="titulo-form">Crear Ticket</h2>
            </div>

            <form asp-action="Crear" method="post">
                @Html.AntiForgeryToken()

                <div class="form-body">

                    <div class="form-group">
                        <label>Título</label>
                        <input asp-for="Titulo" class="form-control" />
                        <span asp-validation-for="Titulo" class="validation-error"></span>
                    </div>

                    <div class="form-group">
                        <label>Categoría</label>
                        <select asp-for="CategoriaTicketId"
                                asp-items="Model.Categorias"
                                class="form-control">
                            <option disabled value="">-- Seleccionar --</option>
                        </select>
                        <span asp-validation-for="CategoriaTicketId" class="validation-error"></span>
                    </div>

                    <div class="form-group">
                        <label>Detalle</label>
                        <textarea asp-for="Contenido" class="form-control"></textarea>
                        <span asp-validation-for="Contenido" class="validation-error"></span>
                    </div>

                    <button type="submit" class="submit-button">
                        Enviar Ticket
                    </button>

                </div>
            </form>
        </div>

        <!-- LISTADO COMPACTO -->
        <div class="mis-tickets">
            <h3>Mis Tickets</h3>

            @if (Model.MisTickets != null && Model.MisTickets.Any())
            {
                @foreach (var ticket in Model.MisTickets)
                {
                    <div class="ticket-mini">
                        <div class="ticket-mini-title">
                            @ticket.Titulo
                        </div>
                        <div class="ticket-mini-meta">
                            @ticket.Categoria · @ticket.Estado <br />
                            @ticket.FechaCreacion.ToString("dd/MM/yyyy HH:mm")
                        </div>
                    </div>
                }
            }
            else
            {
                <p class="ticket-mini-meta">
                    No has creado tickets aún.
                </p>
            }
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
