@model RedBelgrano.DataViewModel.CrearTicketViewModel

<h2>Crear Ticket</h2>

<form asp-action="Crear" method="post">
    @Html.AntiForgeryToken()

    <div>
        <label>Título</label><br />
        <input asp-for="Titulo" />
        <span asp-validation-for="Titulo"></span>
    </div>

    <div>
        <label>Categoría</label><br />
        <select asp-for="CategoriaTicketId" asp-items="Model.Categorias">
        </select>

        <span asp-validation-for="CategoriaTicketId"></span>
    </div>

    <div>
        <label>Contenido</label><br />
        <textarea asp-for="Contenido"></textarea>
        <span asp-validation-for="Contenido"></span>
    </div>

    <br />

    <button type="submit">Enviar Ticket</button>
</form>

<hr />

<h3>Mis Tickets</h3>

@if (Model.MisTickets != null && Model.MisTickets.Any())
{
    <table border="1" cellpadding="5">
        <thead>
            <tr>
                <th>Título</th>
                <th>Categoría</th>
                <th>Estado</th>
                <th>Fecha</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var ticket in Model.MisTickets)
            {
                <tr>
                    <td>@ticket.Titulo</td>
                    <td>@ticket.Categoria</td>
                    <td>@ticket.Estado</td>
                    <td>@ticket.FechaCreacion.ToString("dd/MM/yyyy HH:mm")</td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p>No has creado tickets aún.</p>
}


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
